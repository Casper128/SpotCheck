{
  "name": "spotcheck",
  "version": "0.1.0",
  "private": true,
  "scripts": {
    "dev": "node scripts/dev.mjs",
    "build": "npm run build:frontend",
    "start": "npm run start:frontend",
    "lint": "eslint",
    "test": "npm run test --workspace @spotcheck/shared && node --test scripts/tests/*.test.mjs && npm run test:m3",
    "typecheck": "npm run typecheck --workspaces --if-present",
    "check:architecture": "node scripts/check-architecture.mjs && node scripts/check-residues.mjs",
    "test:m1": "npm run test --workspace @spotcheck/shared && node --test scripts/tests/check-architecture.test.mjs",
    "build:shared": "npm run build --workspace @spotcheck/shared",
    "test:m3": "npm run test --workspace @spotcheck/frontend",
    "start:frontend": "npm run start --workspace @spotcheck/frontend",
    "setup": "node scripts/prepare-env.mjs && npm run build:shared",
    "test:m4": "node scripts/smoke-deployment.mjs",
    "check:residues": "node scripts/check-residues.mjs",
    "test:r1": "tsx --test shared/tests/public-config.test.ts && node --test scripts/tests/check-residues.test.mjs",
    "test:r2": "tsx --test shared/tests/public-config.test.ts && npm run test:r2 --workspace @spotcheck/frontend",
    "test:r3": "npm run test:r3 --workspace @spotcheck/frontend",
    "env:prepare": "node scripts/prepare-env.mjs",
    "docker:up": "node scripts/prepare-env.mjs && docker compose up --build -d",
    "test:r4": "node --test scripts/tests/design-system.test.mjs && node scripts/smoke-deployment.mjs",
    "build:frontend": "npm run build:shared && npm run build --workspace @spotcheck/frontend"
  },
  "devDependencies": {
    "@types/node": "^20",
    "@types/react": "^19",
    "@types/react-dom": "^19",
    "eslint": "^9",
    "eslint-config-next": "16.4.6",
    "tsx": "^4.23.15",
    "typescript": "^5"
  },
  "workspaces": [
    "frontend",
    "shared"
  ],
  "engines": {
    "node": ">=22"
  }
}
